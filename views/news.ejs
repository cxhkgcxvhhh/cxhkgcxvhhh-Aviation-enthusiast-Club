<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>航空新聞 — cxhkgcxvhhh Aviation enthusiast Club</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Microsoft JhengHei', 'PingFang HK', Arial, sans-serif; background: #f4f8fc; color: #1a2b3c; }
    .wrap { max-width: 900px; margin: 40px auto; padding: 0 20px; }
    h1 { font-size: 28px; margin-bottom: 22px; color: #0d2137; }
    .news-card { display: flex; gap: 18px; background: rgba(255,255,255,0.2); backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,0.4); border-radius: 20px; overflow: hidden; margin-bottom: 18px; align-items: flex-start; }
    .news-thumb { width: 240px; height: 160px; flex-shrink: 0; overflow: hidden; }
    .news-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .news-body { padding: 18px 20px 18px 0; flex: 1; min-width: 0; }
    .news-body h2 { font-size: 18px; color: #0d2137; margin-bottom: 8px; }
    .news-body .meta { font-size: 12px; color: #5f7285; margin-bottom: 10px; }
    .news-body .content { font-size: 14px; color: #33475a; line-height: 1.8; white-space: pre-wrap; }
    .news-del { margin-top: 12px; font-size: 12px; font-weight: 700; padding: 6px 16px; border-radius: 999px; border: 1.5px solid rgba(183,28,28,0.5); background: rgba(255,255,255,0.3); color: #b71c1c; cursor: pointer; }
    .news-del:hover { background: rgba(183,28,28,0.1); }
    .empty { text-align: center; padding: 60px 20px; color: #5f7285; font-size: 15px; }
    @media (max-width: 640px) {
      .news-card { flex-direction: column; }
      .news-thumb { width: 100%; height: 180px; }
      .news-body { padding: 14px 18px 18px; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="wrap">
    <h1>📰 航空新聞</h1>

    <% if (newsList.length === 0) { %>
      <div class="empty">暫時未有新聞 😢</div>
    <% } %>

    <% newsList.forEach(function(n) { %>
      <div class="news-card">
        <% if (n.image_url) { %>
          <div class="news-thumb"><img src="<%= n.image_url %>" alt=""></div>
        <% } %>
        <div class="news-body">
          <h2><%= n.title %></h2>
          <div class="meta">來源：<%= n.source %> · 發佈：<%= n.user_name %> · <%= new Date(n.created_at).toLocaleString('zh-HK') %></div>
          <div class="content"><%= n.content %></div>
          <% if (user && user.isSuper) { %>
            <button class="news-del" onclick="delNews(<%= n.id %>)">🗑️ 永久刪除（總管理員）</button>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <% if (user && user.isSuper) { %>
  <script>
    function delNews(id) {
      if (!confirm('⚠️ 確定要永久刪除呢則新聞？\n\n新聞記錄同圖片檔案會全部喺資料庫消失，冇得還原！')) return;
      if (!confirm('⚠️ 最後確認：真係要刪除？呢個動作無法復原！')) return;
      fetch('/api/superadmin/news/' + id + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}'
      }).then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.ok) { location.reload(); }
          else { alert('❌ ' + (d.error || '失敗')); }
        });
    }
  </script>
  <% } %>
</body>
</html>