<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登入 — cxhkgcxvhhh Aviation enthusiast Club</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "Microsoft JhengHei", "PingFang HK", sans-serif;
      background: linear-gradient(180deg, #f4f8fc, #ffffff);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .login-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }
    .login-box {
      background: #ffffff;
      border: 1px solid #e3eaf2;
      border-radius: 16px;
      padding: 48px 40px;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 4px 20px rgba(25, 118, 210, 0.06);
    }
    .login-box img.logo {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      margin-bottom: 16px;
    }
    .login-box h1 {
      font-size: 20px;
      color: #1a2b3c;
      margin-bottom: 8px;
    }
    .login-box p.sub {
      font-size: 14px;
      color: #5f7285;
      margin-bottom: 28px;
      line-height: 1.6;
    }

    /* 同意條款 checkbox */
    .agree-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      text-align: left;
      background: #f4f8fc;
      border: 1px solid #e3eaf2;
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 20px;
      cursor: pointer;
      user-select: none;
    }
    .agree-row input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-top: 1px;
      accent-color: #1976d2;
      cursor: pointer;
      flex-shrink: 0;
    }
    .agree-row span {
      font-size: 13px;
      color: #5f7285;
      line-height: 1.6;
    }
    .agree-row a {
      color: #1976d2;
      text-decoration: none;
    }
    .agree-row a:hover { text-decoration: underline; }
    .agree-row.error {
      border-color: #e57373;
      background: #fff5f5;
      animation: shake 0.3s;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    /* Google 登入掣 */
    .google-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 28px;
      background: transparent;
      border: 2px solid #1976d2;
      border-radius: 30px;
      color: #1976d2;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .google-btn:hover {
      background: #1976d2;
      color: #ffffff;
    }
    .google-btn.disabled {
      border-color: #b0bec5;
      color: #b0bec5;
      cursor: not-allowed;
      pointer-events: none;
    }
    .agree-hint {
      display: none;
      font-size: 12px;
      color: #e57373;
      margin-top: 10px;
    }

    .features {
      margin-top: 28px;
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .features span {
      font-size: 13px;
      color: #5f7285;
      background: #f4f8fc;
      border: 1px solid #e3eaf2;
      padding: 6px 14px;
      border-radius: 20px;
    }
    .terms {
      margin-top: 24px;
      font-size: 12px;
      color: #8ba0b3;
      line-height: 1.7;
    }
    .terms a { color: #1976d2; text-decoration: none; }
    .back-home {
      display: block;
      margin-top: 20px;
      font-size: 13px;
      color: #1976d2;
      text-decoration: none;
    }
    .back-home:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="login-wrap">
    <div class="login-box">
      <img class="logo" src="/images/cxcvaec.png" alt="logo"
           onerror="this.onerror=null;this.style.display='none';">
      <h1>cxhkgcxvhhh<br>Aviation enthusiast Club</h1>
      <p class="sub">登入之後就可以上傳你嘅航空攝影作品、<br>投稿航空新聞，同其他飛機迷一齊交流！</p>

      <!-- 必須剔選先可以登入 -->
      <label class="agree-row" id="agreeRow">
        <input type="checkbox" id="agreeCheck">
        <span>我已閱讀並同意 cxhkgcxvhhh Aviation enthusiast Club 嘅
          <a href="/privacy" target="_blank">私隱政策</a>同
          <a href="/contact" target="_blank">使用條款</a>。
          登入即表示你同意我哋嘅私隱政策同使用條款。</span>
      </label>

      <a class="google-btn disabled" id="googleBtn" href="/auth/google">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/>
        </svg>
        使用 Google 帳戶登入
      </a>
      <p class="agree-hint" id="agreeHint">⚠️ 請先剔選同意私隱政策同使用條款</p>

      <div class="features">
        <span>📷 上傳作品</span>
        <span>✈️ 飛機資料庫</span>
        <span>❤️ 社群互動</span>
      </div>

      <p class="terms">
        登入即表示你同意我哋嘅<a href="/privacy">私隱政策</a>同使用條款
      </p>
      <a class="back-home" href="/">← 返回首頁</a>
    </div>
  </div>

  <script>
    var check = document.getElementById('agreeCheck');
    var btn = document.getElementById('googleBtn');
    var row = document.getElementById('agreeRow');
    var hint = document.getElementById('agreeHint');

    // 剔咗先開通個掣
    check.addEventListener('change', function() {
      if (check.checked) {
        btn.classList.remove('disabled');
        row.classList.remove('error');
        hint.style.display = 'none';
      } else {
        btn.classList.add('disabled');
      }
    });

    // 雙重保險：就算有人用手段撳到個掣，未剔都擋住
    btn.addEventListener('click', function(e) {
      if (!check.checked) {
        e.preventDefault();
        row.classList.remove('error');
        void row.offsetWidth; // 重新觸發動畫
        row.classList.add('error');
        hint.style.display = 'block';
      }
    });
  </script>
</body>
</html>