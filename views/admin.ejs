<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理員審核 - cxhkgcxvhhh Aviation enthusiast Club 圖庫</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Microsoft JhengHei", sans-serif;
        }

        body {
            background: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar {
            background: linear-gradient(135deg, #0f172a, #1e3a5f);
            color: white;
            padding: 16px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .nav-brand a {
            font-size: 1.1rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-btn {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: white;
            padding: 8px 16px;
            font-size: 0.85rem;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-1px);
        }

        .admin-badge {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .container {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 30px 20px;
            flex: 1;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
        }

        .stats-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 20px 25px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
            border: 1px solid #e2e8f0;
            flex: 1;
            text-align: center;
            transition: transform 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: #3b82f6;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 5px;
            font-weight: 600;
        }

        .stat-card.pending .stat-number { color: #f59e0b; }
        .stat-card.approved .stat-number { color: #22c55e; }
        .stat-card.rejected .stat-number { color: #ef4444; }

        .section-title {
            font-size: 1.1rem;
            font-weight: 800;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #0f172a;
        }

        .section-title::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 20px;
            background: linear-gradient(to bottom, #f59e0b, #d97706);
            border-radius: 3px;
        }

        .review-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .review-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
            border: 1px solid #e2e8f0;
            transition: all 0.3s;
        }

        .review-card:hover {
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
            transform: translateY(-3px);
        }

        .review-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
            background: #f1f5f9;
        }

        .review-body {
            padding: 20px;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .review-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .review-user img {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
        }

        .review-user-info {
            display: flex;
            flex-direction: column;
        }

        .review-user-name {
            font-size: 0.9rem;
            font-weight: 700;
            color: #0f172a;
        }

        .review-user-score {
            font-size: 0.75rem;
            color: #f59e0b;
            font-weight: 700;
        }

        .review-date {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 600;
        }

        .review-details {
            margin: 15px 0;
            padding: 12px;
            background: #f8fafc;
            border-radius: 12px;
            font-size: 0.85rem;
        }

        .review-detail-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            border-bottom: 1px solid #e2e8f0;
        }

        .review-detail-row:last-child {
            border-bottom: none;
        }

        .review-detail-label {
            color: #64748b;
            font-weight: 600;
        }

        .review-detail-value {
            color: #0f172a;
            font-weight: 700;
        }

        .review-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .review-btn {
            flex: 1;
            padding: 12px;
            border: none;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .review-btn.approve {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            box-shadow: 0 4px 15px rgba(34, 197, 94, 0.2);
        }

        .review-btn.approve:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
        }

        .review-btn.reject {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2);
        }

        .review-btn.reject:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(239, 68, 68, 0.3);
        }

        .review-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }

        .reject-reason {
            width: 100%;
            margin-top: 10px;
            padding: 10px 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #0f172a;
            background: #f8fafc;
            transition: all 0.2s;
        }

        .reject-reason:focus {
            outline: none;
            border-color: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
        }

        .reject-reason::placeholder {
            color: #94a3b8;
        }

        .loading-state {
            text-align: center;
            padding: 60px 20px;
            color: #94a3b8;
            font-weight: 600;
            grid-column: 1 / -1;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
            grid-column: 1 / -1;
        }

        .empty-state-icon {
            font-size: 60px;
            margin-bottom: 15px;
            opacity: 0.3;
        }

        .empty-state h3 {
            color: #64748b;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .empty-state p {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(10px);
            color: white;
            padding: 14px 28px;
            border-radius: 40px;
            font-size: 0.9rem;
            font-weight: 700;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 1000;
            pointer-events: none;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        .site-footer {
            text-align: center;
            padding: 25px 20px;
            font-size: 0.8rem;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            background: white;
            font-weight: 500;
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 12px 16px;
                flex-wrap: wrap;
                gap: 10px;
            }
            .stats-bar {
                flex-direction: column;
            }
            .review-grid {
                grid-template-columns: 1fr;
            }
            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="nav-brand">
            <a href="/">✈️ cxhkgcxvhhh Aviation enthusiast Club 圖庫</a>
        </div>
        <div class="nav-links">
            <span class="admin-badge">👑 管理員</span>
            <a href="/" class="nav-btn">🏠 首頁</a>
            <a href="/upload" class="nav-btn">📤 上載</a>
            <a href="/auth/logout" class="nav-btn">登出</a>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1>🛡️ 照片審核後台</h1>
        </div>

        <div class="stats-bar">
            <div class="stat-card pending">
                <div class="stat-number" id="pendingCount">0</div>
                <div class="stat-label">待審核</div>
            </div>
            <div class="stat-card approved">
                <div class="stat-number" id="approvedCount">0</div>
                <div class="stat-label">已通過</div>
            </div>
            <div class="stat-card rejected">
                <div class="stat-number" id="rejectedCount">0</div>
                <div class="stat-label">已拒絕</div>
            </div>
        </div>

        <div class="section-title">待審核照片</div>
        <div id="reviewGrid" class="review-grid">
            <div class="loading-state">
                <div>載入中...</div>
            </div>
        </div>
    </div>

    <footer class="site-footer">
        Powered by cxhkgcxvhhh Aviation enthusiast Club © 2026
    </footer>

    <div id="toast" class="toast"></div>

    <script>
        async function loadStats() {
            try {
                const res = await fetch('/api/photos');
                const allPhotos = await res.json();
                
                const pending = allPhotos.filter(p => p.status === 'pending').length;
                const approved = allPhotos.filter(p => p.status === 'approved').length;
                const rejected = allPhotos.filter(p => p.status === 'rejected').length;

                document.getElementById('pendingCount').textContent = pending;
                document.getElementById('approvedCount').textContent = approved;
                document.getElementById('rejectedCount').textContent = rejected;
            } catch (e) {
                console.error('載入統計失敗', e);
            }
        }

        async function loadPendingPhotos() {
            const container = document.getElementById('reviewGrid');
            
            try {
                const res = await fetch('/api/photos/pending');
                const photos = await res.json();

                if (photos.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                            <div class="empty-state-icon">🎉</div>
                            <h3>所有照片已審核完成</h3>
                            <p>暫時沒有待審核的照片</p>
                        </div>
                    `;
                    loadStats();
                    return;
                }

                container.innerHTML = photos.map(photo => `
                    <div class="review-card" id="photo-${photo.id}">
                        <img src="${photo.photo_path}" alt="待審核照片" class="review-img" 
                             onerror="this.src='https://via.placeholder.com/400x300?text=Image+Error'">
                        <div class="review-body">
                            <div class="review-header">
                                <div class="review-user">
                                    <img src="${photo.avatar_url || 'https://via.placeholder.com/36'}" alt="avatar">
                                    <div class="review-user-info">
                                        <div class="review-user-name">${escapeHtml(photo.display_name || 'Unknown')}</div>
                                        <div class="review-user-score">⭐ 現有分數：${photo.score || 0}</div>
                                    </div>
                                </div>
                                <div class="review-date">${new Date(photo.created_at).toLocaleDateString('zh-HK')}</div>
                            </div>
                            
                            <div class="review-details">
                                <div class="review-detail-row">
                                    <span class="review-detail-label">航空公司</span>
                                    <span class="review-detail-value">${escapeHtml(photo.airline)}</span>
                                </div>
                                <div class="review-detail-row">
                                    <span class="review-detail-label">航班號</span>
                                    <span class="review-detail-value">${escapeHtml(photo.flight_number)}</span>
                                </div>
                                <div class="review-detail-row">
                                    <span class="review-detail-label">目的地</span>
                                    <span class="review-detail-value">${escapeHtml(photo.destination)} (${escapeHtml(photo.destination_code)})</span>
                                </div>
                                <div class="review-detail-row">
                                    <span class="review-detail-label">註冊號</span>
                                    <span class="review-detail-value">${escapeHtml(photo.aircraft_registration)}</span>
                                </div>
                                <div class="review-detail-row">
                                    <span class="review-detail-label">型號</span>
                                    <span class="review-detail-value">${escapeHtml(photo.aircraft_model || 'N/A')}</span>
                                </div>
                                <div class="review-detail-row">
                                    <span class="review-detail-label">引擎</span>
                                    <span class="review-detail-value">${escapeHtml(photo.engine_type || 'N/A')}</span>
                                </div>
                            </div>

                            <input type="text" class="reject-reason" id="reason-${photo.id}" 
                                   placeholder="拒絕原因（選填）">

                            <div class="review-actions">
                                <button class="review-btn approve" onclick="reviewPhoto(${photo.id}, 'approved')">
                                    ✅ 通過 (+1分)
                                </button>
                                <button class="review-btn reject" onclick="reviewPhoto(${photo.id}, 'rejected')">
                                    ❌ 拒絕 (-1分)
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('');

                loadStats();

            } catch (error) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">⚠️</div>
                        <h3>載入失敗</h3>
                        <p>請重新整理頁面再試</p>
                    </div>
                `;
            }
        }

        async function reviewPhoto(photoId, status) {
            const reason = document.getElementById(`reason-${photoId}`)?.value || '';
            const card = document.getElementById(`photo-${photoId}`);
            const buttons = card.querySelectorAll('.review-btn');
            
            buttons.forEach(btn => btn.disabled = true);

            try {
                const res = await fetch(`/api/photos/review/${photoId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, rejection_reason: reason })
                });

                const data = await res.json();

                if (data.success) {
                    showToast(status === 'approved' ? '✅ 已通過審核 (+1分)' : '❌ 已拒絕 (-1分)');
                    
                    // 動畫移除卡片
                    card.style.transition = 'all 0.5s';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.9)';
                    setTimeout(() => {
                        card.remove();
                        // 檢查是否還有卡片
                        const grid = document.getElementById('reviewGrid');
                        if (grid.children.length === 0) {
                            loadPendingPhotos();
                        }
                        loadStats();
                    }, 500);
                } else {
                    showToast('❌ 審核失敗：' + (data.error || '未知錯誤'));
                    buttons.forEach(btn => btn.disabled = false);
                }

            } catch (error) {
                showToast('❌ 網絡錯誤');
                buttons.forEach(btn => btn.disabled = false);
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showToast(text) {
            const t = document.getElementById('toast');
            t.textContent = text;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }

        // 初始化
        loadPendingPhotos();
    </script>
</body>
</html>