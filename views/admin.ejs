<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>審核中心 — cxhkgcxvhhh Aviation enthusiast Club</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "Microsoft JhengHei", "PingFang HK", sans-serif;
      min-height: 100vh; color: #1a2b3c;
    }
    .wrap { max-width: 1100px; margin: 0 auto; padding: 36px 20px 60px; }
    .page-title {
      font-size: 24px; font-weight: 700;
      border-left: 4px solid #1976d2; padding-left: 12px; margin-bottom: 18px;
    }

    .rules-box { border-radius: 14px; padding: 18px 22px; margin-bottom: 22px; }
    .rules-box h3 { font-size: 15px; color: #7a6510; margin-bottom: 10px; cursor: pointer; user-select: none; }
    .rules-box ul { margin: 0 0 0 20px; font-size: 13px; color: #7a6510; line-height: 1.9; }
    .rules-body { display: none; }
    .rules-body.open { display: block; }

    .stats-row { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 22px; }
    .stat-chip { border-radius: 12px; padding: 12px 20px; font-size: 14px; color: #5f7285; }
    .stat-chip b { color: #1a2b3c; font-size: 18px; margin-left: 6px; }

    .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
    .tab-btn {
      background: transparent; border: 2px solid #1976d2; color: #1976d2;
      border-radius: 22px; padding: 8px 20px; font-size: 14px; font-weight: 600;
      cursor: pointer; transition: all 0.15s;
    }
    .tab-btn:hover { background: #eaf3fc; }
    .tab-btn.active { background: #1976d2; color: #ffffff; }
    .tab-btn .badge {
      display: inline-block; background: #d32f2f; color: #fff;
      border-radius: 10px; font-size: 11px; padding: 1px 8px; margin-left: 6px;
    }
    .tab-btn.active .badge { background: #ffffff; color: #1976d2; }

    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .p-card { border-radius: 14px; overflow: hidden; }
    .p-card img { width: 100%; height: 170px; object-fit: cover; display: block; background: #e3eaf2; cursor: zoom-in; }
    .p-body { padding: 14px 16px 16px; }
    .p-title { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
    .p-meta { font-size: 13px; color: #5f7285; line-height: 1.7; }
    .p-reason { margin-top: 8px; font-size: 12px; color: #d32f2f; background: rgba(255,240,240,0.6); border-radius: 8px; padding: 8px 10px; }
    .p-note { margin-top: 8px; font-size: 12px; color: #1565c0; background: rgba(234,243,252,0.6); border-radius: 8px; padding: 8px 10px; }
    .p-reviewer { margin-top: 8px; font-size: 12px; color: #5f7285; }
    .p-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
    .btn-a { flex: 1; min-width: 70px; background: transparent; border: 2px solid #2e7d32; color: #2e7d32; border-radius: 18px; padding: 7px 0; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-r { flex: 1; min-width: 70px; background: transparent; border: 2px solid #d32f2f; color: #d32f2f; border-radius: 18px; padding: 7px 0; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-f { flex: 1; min-width: 70px; background: transparent; border: 2px solid #f9a825; color: #f9a825; border-radius: 18px; padding: 7px 0; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-e { flex: 1; min-width: 70px; background: transparent; border: 2px solid #7b1fa2; color: #7b1fa2; border-radius: 18px; padding: 7px 0; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-d { flex: 1; min-width: 70px; background: transparent; border: 2px solid #b71c1c; color: #b71c1c; border-radius: 18px; padding: 7px 0; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-d:hover { background: rgba(183,28,28,0.08); }

    .empty { text-align: center; color: #8ba0b3; padding: 50px 20px; border-radius: 14px; }

    .n-card { border-radius: 14px; padding: 18px 20px; margin-bottom: 14px; }
    .n-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
    .n-content { font-size: 14px; color: #5f7285; line-height: 1.7; margin-bottom: 8px; }
    .n-meta { font-size: 12px; color: #8ba0b3; }
    .n-group-title { font-size: 15px; font-weight: 700; color: #1a2b3c; margin: 22px 0 12px; padding-left: 10px; border-left: 3px solid #1976d2; }

    .toast {
      position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%);
      background: #1a2b3c; color: #fff; padding: 12px 26px; border-radius: 24px;
      font-size: 14px; display: none; z-index: 999;
    }
    .toast.err { background: #d32f2f; }

    .lightbox {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(10, 20, 30, 0.92); cursor: zoom-out;
      align-items: center; justify-content: center; padding: 30px;
    }
    .lightbox.open { display: flex; }
    .lightbox img { max-width: 95%; max-height: 92vh; border-radius: 10px; }
    .lightbox .lb-close { position: absolute; top: 18px; right: 26px; color: #fff; font-size: 34px; cursor: pointer; font-weight: 300; }

    /* 修改資料彈窗 */
    .modal {
      display: none; position: fixed; inset: 0; z-index: 1100;
      background: rgba(10, 20, 30, 0.6); overflow-y: auto; padding: 40px 16px;
    }
    .modal.open { display: block; }
    .modal-card {
      max-width: 720px; margin: 0 auto; border-radius: 18px; padding: 26px 28px;
      background: rgba(255,255,255,0.92) !important;
    }
    .modal-card h3 { font-size: 18px; margin-bottom: 16px; }
    .m-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .m-grid .full { grid-column: 1 / -1; }
    .m-grid label { display: block; font-size: 12px; font-weight: 600; color: #5f7285; margin-bottom: 4px; }
    .m-grid input, .m-grid textarea {
      width: 100%; padding: 9px 12px; border: 1.5px solid #d8e3ee; border-radius: 10px;
      font-size: 13px; font-family: inherit;
    }
    .m-actions { display: flex; gap: 10px; margin-top: 18px; }
    .m-actions button { flex: 1; padding: 11px; border-radius: 20px; font-size: 14px; font-weight: 700; cursor: pointer; }
    .m-save { background: #1976d2; color: #fff; border: none; }
    .m-cancel { background: transparent; border: 2px solid #8ba0b3; color: #5f7285; }

    /* 原因模板彈窗（拒絕／要求補充） */
    .rchip-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; max-height: 220px; overflow-y: auto; padding: 2px; }
    .rchip {
      background: transparent; border: 1.5px solid #d8e3ee; color: #5f7285;
      border-radius: 16px; padding: 5px 12px; font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all 0.15s; user-select: none;
    }
    .rchip:hover { border-color: #1976d2; color: #1976d2; }
    .rchip.on { background: #1976d2; border-color: #1976d2; color: #ffffff; }
    .reason-textarea {
      width: 100%; padding: 10px 12px; border: 1.5px solid #d8e3ee; border-radius: 10px;
      font-size: 13px; font-family: inherit; resize: vertical; min-height: 80px;
    }
    .reason-hint { font-size: 12px; color: #8ba0b3; margin: 6px 0 10px; }
    .m-confirm-r { background: #d32f2f; color: #fff; border: none; }
    .m-confirm-r:disabled { background: #e0b4b4; cursor: not-allowed; }
    .m-confirm-c { background: #7b1fa2; color: #fff; border: none; }
    .m-confirm-c:disabled { background: #d7bde2; cursor: not-allowed; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:18px;">
      <div class="page-title" style="margin-bottom:0;">審核中心</div>
      <a href="/admin/stats" style="background:transparent;border:2px solid #1976d2;color:#1976d2;border-radius:22px;padding:8px 20px;font-size:14px;font-weight:600;text-decoration:none;">📊 統計儀表板</a>
    </div>

    <!-- 審核規例 -->
    <div class="rules-box">
      <h3 onclick="document.getElementById('rulesBody').classList.toggle('open')">📋 審核規例（撳嚟展開／收起）▼</h3>
      <div class="rules-body open" id="rulesBody">
        <b>✅ 通過條件：</b>
        <ul>
          <li>相片主題必須同航空有關，而且係投稿者本人拍攝</li>
          <li><b>註冊號必須清晰可見</b>（或者可以從相片清楚辨認到架機）</li>
          <li>相片主體清晰、構圖合理、有足夠解像度</li>
        </ul>
        <b style="display:block;margin-top:10px;">❌ 常見拒絕原因：</b>
        <ul>
          <li>註冊號模糊／遮擋，無法辨認飛機身份</li>
          <li><b>過度曝光或曝光不足</b>，相片主體睇唔清楚</li>
          <li>相片模糊、手震、解像度太低</li>
          <li>主體太細或裁切不當</li>
          <li>同航空無關嘅內容／廣告</li>
          <li>懷疑盜用他人作品</li>
        </ul>
        <p style="margin-top:10px;font-size:12px;">💡 如果只係資料有啲錯漏，請用「✏️ 要求補充資料」（唔會扣投稿人分數）或者直接「📝 修改資料」幫佢改，唔使拒絕！</p>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-chip">今日上傳<b><%= todayTotal %></b></div>
      <div class="stat-chip">今日通過<b><%= todayApproved %></b></div>
      <div class="stat-chip">今日拒絕<b><%= todayRejected %></b></div>
      <div class="stat-chip">在線管理員<b><%= onlineAdmins %></b></div>
    </div>

    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('pending', this)">
        待審核<span class="badge"><%= pendingPhotos.length %></span>
      </button>
      <button class="tab-btn" onclick="showTab('changes', this)">
        待補充<span class="badge"><%= changesPhotos.length %></span>
      </button>
      <button class="tab-btn" onclick="showTab('approved', this)">已通過</button>
      <button class="tab-btn" onclick="showTab('rejected', this)">已拒絕</button>
      <button class="tab-btn" onclick="showTab('featured', this)">精選／輪播</button>
      <button class="tab-btn" onclick="showTab('news', this)">新聞</button>
    </div>

    <!-- 待審核 -->
    <div class="tab-panel active" id="tab-pending">
      <% if (pendingPhotos.length === 0) { %>
        <div class="empty">🎉 冇待審核嘅相片，全部搞掂！</div>
      <% } else { %>
        <div class="grid">
          <% pendingPhotos.forEach(p => { %>
            <div class="p-card" id="photo-<%= p.id %>">
              <img src="<%= p.image_url %>" alt="" onclick="openLightbox('<%= p.image_url %>')">
              <div class="p-body">
                <div class="p-title"><%= p.title %></div>
                <div class="p-meta">
                  📸 <%= p.user_name %><br>
                  <%= p.airline || '—' %> · <%= p.aircraft_type || '—' %><br>
                  <%= p.registration || '—' %> · <%= p.origin || '?' %> → <%= p.destination || '?' %>
                </div>
                <div class="p-actions">
                  <button class="btn-a" onclick="setStatus(<%= p.id %>, 'approved')">✅ 通過</button>
                  <button class="btn-r" onclick="rejectPhoto(<%= p.id %>)">❌ 拒絕</button>
                  <button class="btn-e" onclick="requestChanges(<%= p.id %>)">✏️ 要求補充</button>
                  <button class="btn-e" onclick="openEdit(<%= p.id %>)">📝 修改資料</button>
                  <% if (user && user.isSuper) { %>
                    <button class="btn-d" onclick="deletePhoto(<%= p.id %>)">🗑️ 永久刪除</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 待補充 -->
    <div class="tab-panel" id="tab-changes">
      <% if (changesPhotos.length === 0) { %>
        <div class="empty">暫時冇等待補充資料嘅相片</div>
      <% } else { %>
        <div class="grid">
          <% changesPhotos.forEach(p => { %>
            <div class="p-card" id="photo-<%= p.id %>">
              <img src="<%= p.image_url %>" alt="" onclick="openLightbox('<%= p.image_url %>')">
              <div class="p-body">
                <div class="p-title"><%= p.title %></div>
                <div class="p-meta">📸 <%= p.user_name %><br><%= p.airline || '—' %> · <%= p.aircraft_type || '—' %></div>
                <% if (p.admin_note) { %><div class="p-note">✏️ 要求補充：<%= p.admin_note %></div><% } %>
                <div class="p-reviewer">👑 <%= p.reviewed_by || '—' %> · 等待投稿人補充中</div>
                <div class="p-actions">
                  <button class="btn-a" onclick="setStatus(<%= p.id %>, 'approved')">✅ 直接通過</button>
                  <button class="btn-e" onclick="openEdit(<%= p.id %>)">📝 修改資料</button>
                  <% if (user && user.isSuper) { %>
                    <button class="btn-d" onclick="deletePhoto(<%= p.id %>)">🗑️ 永久刪除</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 已通過 -->
    <div class="tab-panel" id="tab-approved">
      <% const approvedList = allPhotos.filter(p => p.status === 'approved'); %>
      <% if (approvedList.length === 0) { %>
        <div class="empty">暫時未有已通過嘅相片</div>
      <% } else { %>
        <div class="grid">
          <% approvedList.forEach(p => { %>
            <div class="p-card" id="photo-<%= p.id %>">
              <img src="<%= p.image_url %>" alt="" onclick="openLightbox('<%= p.image_url %>')">
              <div class="p-body">
                <div class="p-title"><%= p.title %> <%= p.is_featured ? '⭐' : '' %></div>
                <div class="p-meta">📸 <%= p.user_name %><br><%= p.airline || '—' %> · <%= p.aircraft_type || '—' %></div>
                <div class="p-reviewer">👑 審核員：<%= p.reviewed_by || '—' %></div>
                <div class="p-actions">
                  <% if (user && user.isSuper) { %>
                    <button class="btn-f <%= p.is_featured ? 'on' : '' %>" onclick="toggleFeatured(<%= p.id %>, <%= !p.is_featured %>)">
                      <%= p.is_featured ? '⭐ 取消精選' : '⭐ 設為精選' %>
                    </button>
                  <% } %>
                  <button class="btn-e" onclick="openEdit(<%= p.id %>)">📝 修改資料</button>
                  <button class="btn-r" onclick="rejectPhoto(<%= p.id %>)">❌ 改為拒絕</button>
                  <% if (user && user.isSuper) { %>
                    <button class="btn-d" onclick="deletePhoto(<%= p.id %>)">🗑️ 永久刪除</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 已拒絕 -->
    <div class="tab-panel" id="tab-rejected">
      <% const rejectedList = allPhotos.filter(p => p.status === 'rejected'); %>
      <% if (rejectedList.length === 0) { %>
        <div class="empty">暫時未有被拒絕嘅相片</div>
      <% } else { %>
        <div class="grid">
          <% rejectedList.forEach(p => { %>
            <div class="p-card" id="photo-<%= p.id %>">
              <img src="<%= p.image_url %>" alt="" onclick="openLightbox('<%= p.image_url %>')">
              <div class="p-body">
                <div class="p-title"><%= p.title %></div>
                <div class="p-meta">📸 <%= p.user_name %><br><%= p.airline || '—' %> · <%= p.aircraft_type || '—' %></div>
                <% if (p.reject_reason) { %><div class="p-reason">拒絕原因：<%= p.reject_reason %></div><% } %>
                <div class="p-reviewer">👑 審核員：<%= p.reviewed_by || '—' %></div>
                <div class="p-actions">
                  <button class="btn-a" onclick="setStatus(<%= p.id %>, 'approved')">✅ 改為通過</button>
                  <% if (user && user.isSuper) { %>
                    <button class="btn-d" onclick="deletePhoto(<%= p.id %>)">🗑️ 永久刪除</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 精選 -->
    <div class="tab-panel" id="tab-featured">
      <p class="p-note">🖼️ 呢度列出嘅精選相片會喺首頁頂部輪播顯示。想加新相入輪播，去「已通過」分頁撳 ⭐；想移除就喺下面撳「取消精選」。（只有總管理員可以設定）</p>
      <% const featuredList = allPhotos.filter(p => p.status === 'approved' && p.is_featured); %>
      <% if (featuredList.length === 0) { %>
        <div class="empty"><%= (user && user.isSuper) ? '暫時未有精選作品，去「已通過」嗰度撳 ⭐ 啦！' : '暫時未有精選作品（只有總管理員可以設定精選）' %></div>
      <% } else { %>
        <div class="grid">
          <% featuredList.forEach(p => { %>
            <div class="p-card" id="photo-<%= p.id %>">
              <img src="<%= p.image_url %>" alt="" onclick="openLightbox('<%= p.image_url %>')">
              <div class="p-body">
                <div class="p-title">⭐ <%= p.title %></div>
                <div class="p-meta">📸 <%= p.user_name %><br><%= p.airline || '—' %> · <%= p.aircraft_type || '—' %></div>
                <% if (user && user.isSuper) { %>
                  <div class="p-actions">
                    <button class="btn-f on" onclick="toggleFeatured(<%= p.id %>, false)">⭐ 取消精選</button>
                    <button class="btn-d" onclick="deletePhoto(<%= p.id %>)">🗑️ 永久刪除</button>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- 新聞 -->
    <div class="tab-panel" id="tab-news">
      <div class="n-group-title">待審核新聞</div>
      <% const pendingNews = allNews.filter(n => n.status === 'pending'); %>
      <% if (pendingNews.length === 0) { %><div class="empty">冇待審核嘅新聞</div><% } %>
      <% pendingNews.forEach(n => { %>
        <div class="n-card" id="news-<%= n.id %>">
          <div class="n-title"><%= n.title %></div>
          <div class="n-content"><%= n.content %></div>
          <div class="n-meta">✍️ 投稿人：<%= n.user_name %> · 🕐 <%= new Date(n.created_at).toLocaleString('zh-HK') %> <%= n.source ? '· 來源：' + n.source : '' %></div>
          <div class="p-actions">
            <button class="btn-a" onclick="setNewsStatus(<%= n.id %>, 'approved')">✅ 發佈</button>
            <button class="btn-r" onclick="rejectNews(<%= n.id %>)">❌ 拒絕</button>
          </div>
        </div>
      <% }) %>

      <div class="n-group-title">已發佈新聞</div>
      <% const okNews = allNews.filter(n => n.status === 'approved'); %>
      <% if (okNews.length === 0) { %><div class="empty">暫時未有已發佈嘅新聞</div><% } %>
      <% okNews.forEach(n => { %>
        <div class="n-card" id="news-<%= n.id %>">
          <div class="n-title"><%= n.title %></div>
          <div class="n-meta">✍️ <%= n.user_name %> · 👑 審核員：<%= n.reviewed_by || '—' %></div>
          <div class="p-actions">
            <button class="btn-r" onclick="rejectNews(<%= n.id %>)">❌ 下架</button>
          </div>
        </div>
      <% }) %>

      <div class="n-group-title">已拒絕新聞</div>
      <% const badNews = allNews.filter(n => n.status === 'rejected'); %>
      <% if (badNews.length === 0) { %><div class="empty">暫時冇被拒絕嘅新聞</div><% } %>
      <% badNews.forEach(n => { %>
        <div class="n-card" id="news-<%= n.id %>">
          <div class="n-title"><%= n.title %></div>
          <% if (n.reject_reason) { %><div class="p-reason">拒絕原因：<%= n.reject_reason %></div><% } %>
          <div class="n-meta">✍️ <%= n.user_name %> · 👑 審核員：<%= n.reviewed_by || '—' %></div>
          <div class="p-actions">
            <button class="btn-a" onclick="setNewsStatus(<%= n.id %>, 'approved')">✅ 重新發佈</button>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <!-- 圖片放大 -->
  <div class="lightbox" id="lightbox" onclick="closeLightbox()">
    <span class="lb-close">✕</span>
    <img id="lightboxImg" src="" alt="放大圖片">
  </div>

  <!-- 📝 修改資料彈窗 -->
  <div class="modal" id="editModal">
    <div class="modal-card">
      <h3>📝 修改相片資料（#<span id="editId"></span>）</h3>
      <div class="m-grid">
        <div class="full"><label>標題</label><input id="eTitle"></div>
        <div><label>註冊號</label><input id="eRegistration"></div>
        <div><label>航空公司</label><input id="eAirline"></div>
        <div><label>航班編號</label><input id="eFlight"></div>
        <div><label>機型</label><input id="eType"></div>
        <div><label>塗裝</label><input id="eLivery"></div>
        <div><label>出發機場</label><input id="eOrigin"></div>
        <div><label>目的地機場</label><input id="eDest"></div>
        <div><label>拍攝日期</label><input id="eDate"></div>
        <div><label>拍攝位置</label><input id="eLocation"></div>
        <div class="full"><label>相機設定</label><input id="eCamera"></div>
        <div class="full"><label>額外資料</label><textarea id="eExtra" rows="2"></textarea></div>
      </div>
      <div class="m-actions">
        <button class="m-save" onclick="saveEdit()">💾 儲存修改</button>
        <button class="m-cancel" onclick="closeEdit()">取消</button>
      </div>
    </div>
  </div>

  <!-- ❌✏️ 原因模板彈窗（拒絕／要求補充共用，可多選＋自由改字） -->
  <div class="modal" id="reasonModal">
    <div class="modal-card">
      <h3 id="reasonTitle">❌ 拒絕原因</h3>
      <div class="reason-hint">👇 撳下面嘅預設原因（可以揀多個），會自動填入下面個框；填入之後你可以自由加字改字。</div>
      <div class="rchip-row" id="rchipRow"></div>
      <textarea class="reason-textarea" id="reasonText" rows="4" oninput="checkReasonInput()" placeholder="亦可以直接喺度打字……"></textarea>
      <div class="m-actions">
        <button id="reasonConfirmBtn" class="m-confirm-r" onclick="confirmReason()" disabled>確認</button>
        <button class="m-cancel" onclick="closeReasonModal()">取消</button>
      </div>
    </div>
  </div>

  <script>
    // 所有相片資料（修改彈窗用）
    var PHOTOS = <%- JSON.stringify(allPhotos.map(p => ({
      id: p.id, title: p.title, registration: p.registration, airline: p.airline,
      flight_number: p.flight_number, aircraft_type: p.aircraft_type, livery: p.livery,
      origin: p.origin, destination: p.destination, photo_date: p.photo_date,
      location: p.location, camera_settings: p.camera_settings, extra_info: p.extra_info
    }))) %>;

    // ===== 預設原因模板（多選） =====
    var REJECT_PRESETS = [
      '相片太暗，主體睇唔清楚',
      '相片過曝，細節流失',
      '解像度太低',
      '相片模糊／手震',
      '對焦唔準',
      '相片有塵點／鏡頭污漬',
      '構圖不佳（飛機被切邊）',
      '主體太細，佔畫面太少',
      '背景太雜亂',
      '有遮擋物（圍網／欄杆／玻璃反光）',
      '顏色偏差／白平衡問題',
      '過度後製／失真',
      '水印太大或遮擋主體',
      '註冊號模糊／遮擋，無法辨認飛機身份',
      '重複上載相同相片',
      '與已通過嘅相片過於相似',
      '註冊編號（Registration）資料錯誤',
      '航空公司資料錯誤',
      '機型資料錯誤',
      '拍攝地點／日期資料錯誤',
      '塗裝類型揀錯',
      '非航空主題相片',
      '懷疑侵權／非本人拍攝'
    ];
    var CHANGES_PRESETS = [
      '請補充註冊編號（Registration）',
      '請補充航空公司資料',
      '請補充機型資料',
      '請補充航班編號',
      '請註明拍攝日期',
      '請註明拍攝地點',
      '請揀返正確嘅塗裝類型',
      '請更正註冊編號',
      '請更正航空公司',
      '請更正機型',
      '請補充相機設定（快門／光圈／ISO）',
      '請修改標題，等佢更貼切'
    ];

    var reasonMode = null;    // 'reject' 或 'changes'
    var reasonPhotoId = null;

    function showTab(name, btn) {
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
      document.getElementById('tab-' + name).classList.add('active');
      btn.classList.add('active');
    }

    function toast(msg, isErr) {
      var t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast' + (isErr ? ' err' : '');
      t.style.display = 'block';
      setTimeout(function() { t.style.display = 'none'; }, 2800);
    }

    function post(url, data, onOk) {
      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data || {})
      })
      .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
      .then(function(res) {
        if (res.ok && res.data.ok) { onOk(); }
        else { toast('❌ 失敗：' + (res.data.error || '未知錯誤'), true); }
      })
      .catch(function() { toast('❌ 網絡錯誤', true); });
    }

    function setStatus(id, status, reason) {
      post('/api/admin/photos/' + id + '/status', { status: status, reason: reason || '' }, function() {
        toast(status === 'approved' ? '✅ 已通過（投稿人 +1 分，已寄彩色電郵）' : '❌ 已拒絕（投稿人 −1 分，已寄電郵）');
        setTimeout(function() { location.reload(); }, 900);
      });
    }

    // ===== 原因模板彈窗邏輯 =====
    function openReasonModal(id, mode) {
      reasonMode = mode;
      reasonPhotoId = id;
      document.getElementById('reasonTitle').textContent =
        (mode === 'reject' ? '❌ 拒絕原因' : '✏️ 要求補充資料') + '（#' + id + '）';
      document.getElementById('reasonText').value = '';
      var btn = document.getElementById('reasonConfirmBtn');
      btn.className = mode === 'reject' ? 'm-confirm-r' : 'm-confirm-c';
      btn.textContent = mode === 'reject' ? '❌ 確認拒絕' : '✏️ 確認要求補充';
      btn.disabled = true;
      // 砌預設掣
      var presets = mode === 'reject' ? REJECT_PRESETS : CHANGES_PRESETS;
      var row = document.getElementById('rchipRow');
      row.innerHTML = '';
      presets.forEach(function(text) {
        var chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'rchip';
        chip.textContent = text;
        chip.onclick = function() { toggleRchip(chip, text); };
        row.appendChild(chip);
      });
      document.getElementById('reasonModal').classList.add('open');
    }

    function toggleRchip(chip, text) {
      var ta = document.getElementById('reasonText');
      if (chip.classList.contains('on')) {
        // 取消：將呢段字喺個框度移除
        chip.classList.remove('on');
        var v = ta.value;
        v = v.split('；' + text).join('');
        v = v.split(text + '；').join('');
        v = v.split(text).join('');
        v = v.replace(/^；+|；+$/g, '').replace(/；{2,}/g, '；');
        ta.value = v;
      } else {
        // 揀選：加入去個框（如果未有嘅話）
        chip.classList.add('on');
        if (ta.value.indexOf(text) === -1) {
          ta.value = ta.value ? (ta.value.replace(/；+$/, '') + '；' + text) : text;
        }
      }
      checkReasonInput();
    }

    function checkReasonInput() {
      var hasText = document.getElementById('reasonText').value.trim().length > 0;
      document.getElementById('reasonConfirmBtn').disabled = !hasText;
    }

    function closeReasonModal() {
      document.getElementById('reasonModal').classList.remove('open');
      reasonMode = null;
      reasonPhotoId = null;
    }

    function confirmReason() {
      var text = document.getElementById('reasonText').value.trim();
      if (!text || !reasonPhotoId) return;
      var id = reasonPhotoId;
      var mode = reasonMode;
      closeReasonModal();
      if (mode === 'reject') {
        setStatus(id, 'rejected', text);
      } else {
        post('/api/admin/photos/' + id + '/request-changes', { note: text }, function() {
          toast('✏️ 已要求補充資料（唔扣分，已寄藍色電郵畀投稿人）');
          setTimeout(function() { location.reload(); }, 900);
        });
      }
    }

    function rejectPhoto(id) {
      openReasonModal(id, 'reject');
    }

    // ✏️ 要求補充資料（唔扣分）
    function requestChanges(id) {
      openReasonModal(id, 'changes');
    }

    // 📝 修改資料彈窗
    var editingId = null;
    function openEdit(id) {
      var p = PHOTOS.find(function(x) { return x.id === id; });
      if (!p) return;
      editingId = id;
      document.getElementById('editId').textContent = id;
      document.getElementById('eTitle').value = p.title || '';
      document.getElementById('eRegistration').value = p.registration || '';
      document.getElementById('eAirline').value = p.airline || '';
      document.getElementById('eFlight').value = p.flight_number || '';
      document.getElementById('eType').value = p.aircraft_type || '';
      document.getElementById('eLivery').value = p.livery || '';
      document.getElementById('eOrigin').value = p.origin || '';
      document.getElementById('eDest').value = p.destination || '';
      document.getElementById('eDate').value = p.photo_date || '';
      document.getElementById('eLocation').value = p.location || '';
      document.getElementById('eCamera').value = p.camera_settings || '';
      document.getElementById('eExtra').value = p.extra_info || '';
      document.getElementById('editModal').classList.add('open');
    }
    function closeEdit() {
      document.getElementById('editModal').classList.remove('open');
      editingId = null;
    }
    function saveEdit() {
      if (!editingId) return;
      post('/api/admin/photos/' + editingId + '/edit', {
        title: document.getElementById('eTitle').value,
        registration: document.getElementById('eRegistration').value,
        airline: document.getElementById('eAirline').value,
        flight_number: document.getElementById('eFlight').value,
        aircraft_type: document.getElementById('eType').value,
        livery: document.getElementById('eLivery').value,
        origin: document.getElementById('eOrigin').value,
        destination: document.getElementById('eDest').value,
        photo_date: document.getElementById('eDate').value,
        location: document.getElementById('eLocation').value,
        camera_settings: document.getElementById('eCamera').value,
        extra_info: document.getElementById('eExtra').value
      }, function() {
        toast('💾 資料已修改');
        setTimeout(function() { location.reload(); }, 700);
      });
    }

    // 🗑️ 永久刪除（總管理員）：相片記錄、留言、收藏、圖片檔案全部消失
    function deletePhoto(id) {
      if (!confirm('⚠️ 確定要永久刪除呢張相片？\n\n相片記錄、所有留言、所有人嘅收藏、同埋圖片檔案會全部喺資料庫消失，冇得還原！')) return;
      if (!confirm('⚠️ 最後確認：真係要刪除？呢個動作無法復原！')) return;
      post('/api/superadmin/photos/' + id + '/delete', {}, function() {
        toast('🗑️ 相片已永久刪除');
        setTimeout(function() { location.reload(); }, 700);
      });
    }

    function toggleFeatured(id, featured) {
      post('/api/admin/photos/' + id + '/featured', { featured: featured }, function() {
        toast(featured ? '⭐ 已設為精選' : '已取消精選');
        setTimeout(function() { location.reload(); }, 700);
      });
    }

    function setNewsStatus(id, status, reason) {
      post('/api/admin/news/' + id + '/status', { status: status, reason: reason || '' }, function() {
        toast(status === 'approved' ? '✅ 新聞已發佈' : '❌ 新聞已拒絕');
        setTimeout(function() { location.reload(); }, 700);
      });
    }

    function rejectNews(id) {
      var reason = prompt('請輸入拒絕原因：');
      if (reason === null) return;
      setNewsStatus(id, 'rejected', reason);
    }

    function openLightbox(src) {
      document.getElementById('lightboxImg').src = src;
      document.getElementById('lightbox').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      document.getElementById('lightbox').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { closeLightbox(); closeEdit(); closeReasonModal(); }
    });
  </script>
</body>
</html>