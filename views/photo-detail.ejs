<%- include('partials/header', { title: photo.title, active: '' }) %>

<style>
  body { background: #f8fafc !important; }
  
  :root {
    --card-bg: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --radius-lg: 24px;
    --shadow-sm: 0 2px 10px rgba(15, 23, 42, 0.03);
    --shadow-md: 0 10px 30px rgba(15, 23, 42, 0.06);
  }

  .detail-page {
    max-width: 900px;
    margin: 30px auto;
    padding: 0 20px;
  }

  .photo-main {
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--card-bg);
    margin-bottom: 24px;
    position: relative;
  }

  .photo-main img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 600px;
    object-fit: contain;
  }

  .photo-status-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    backdrop-filter: blur(20px);
    background: rgba(255,255,255,0.95);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .status-pending { color: #d97706; }
  .status-approved { color: #059669; }
  .status-rejected { color: #dc2626; }

  .info-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(226, 232, 240, 0.8);
    margin-bottom: 24px;
  }

  .info-title {
    font-size: 1.4rem; font-weight: 800;
    color: var(--text-main); margin-bottom: 20px;
    display: flex; align-items: center; gap: 10px;
  }
  .info-title span {
    display: inline-block; width: 5px; height: 20px;
    background: linear-gradient(to bottom, #3b82f6, #60a5fa);
    border-radius: 3px;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .info-item {
    padding: 14px 16px;
    background: #f8fafc;
    border-radius: 14px;
    border: 1px solid var(--border-color);
  }

  .info-label {
    font-size: 0.75rem; font-weight: 700;
    color: #94a3b8; text-transform: uppercase;
    letter-spacing: 0.5px; margin-bottom: 6px;
  }

  .info-value {
    font-size: 1rem; font-weight: 700;
    color: var(--text-main);
  }

  .photographer-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
  }

  .photographer-avatar {
    width: 44px; height: 44px;
    border-radius: 50%; object-fit: cover;
    border: 2px solid #e2e8f0;
  }

  .photographer-info {
    flex: 1;
  }

  .photographer-name {
    font-size: 1rem; font-weight: 700;
    color: var(--text-main);
  }

  .photographer-date {
    font-size: 0.8rem; color: var(--text-muted);
  }

  /* 管理員審核按鈕 */
  .admin-actions {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .admin-btn {
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: 16px;
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .btn-approve-big {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
  }
  .btn-approve-big:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(16, 185, 129, 0.4);
  }

  .btn-reject-big {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3);
  }
  .btn-reject-big:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.4);
  }

  .reject-panel {
    display: none;
    background: #fee2e2;
    border: 2px solid #fecaca;
    border-radius: 16px;
    padding: 20px;
    margin-top: 12px;
    animation: slideDown 0.3s ease;
  }

  .reject-panel.show { display: block; }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reject-title {
    font-size: 1rem; font-weight: 700;
    color: #991b1b; margin-bottom: 12px;
  }

  .reject-textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #fecaca;
    border-radius: 12px;
    font-size: 0.95rem;
    color: var(--text-main);
    background: white;
    box-sizing: border-box;
    resize: vertical;
    min-height: 80px;
    margin-bottom: 12px;
  }
  .reject-textarea:focus {
    outline: none;
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
  }

  .reject-confirm-btn {
    width: 100%;
    padding: 12px;
    background: #dc2626;
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .reject-confirm-btn:hover {
    background: #b91c1c;
  }

  .back-link {
    display: inline-flex; align-items: center;
    gap: 6px; margin-top: 20px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem; font-weight: 600;
  }
  .back-link:hover { color: #3b82f6; }

  .reviewer-box {
    margin-top: 16px;
    padding: 14px 18px;
    background: #f0f7ff;
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    font-size: 0.85rem;
    color: #1d4ed8;
  }
  .reviewer-box strong { color: #1e40af; }

  .rejection-box {
    margin-top: 16px;
    padding: 14px 18px;
    background: #fee2e2;
    border: 1.5px solid #fecaca;
    border-radius: 14px;
    font-size: 0.85rem;
    color: #dc2626;
  }
  .rejection-box strong { color: #991b1b; }

  @media (max-width: 600px) {
    .info-grid { grid-template-columns: 1fr; }
    .info-card { padding: 20px; }
  }
</style>

<div class="detail-page animate-fade-in">
  
  <!-- 大圖 -->
  <div class="photo-main">
    <img src="<%= photo.image_url %>" alt="<%= photo.title %>">
    <span class="photo-status-badge status-<%= photo.status %>">
      <%= photo.status === 'pending' ? '⏳ 待審核' : photo.status === 'approved' ? '✅ 已批准' : '❌ 已拒絕' %>
    </span>
  </div>

  <!-- 資料卡 -->
  <div class="info-card">
    <div class="info-title"><span></span><%= photo.title %></div>
    
    <div class="info-grid">
      <% if (photo.airline) { %>
      <div class="info-item">
        <div class="info-label">航空公司</div>
        <div class="info-value"><%= photo.airline %></div>
      </div>
      <% } %>
      <% if (photo.registration) { %>
      <div class="info-item">
        <div class="info-label">註冊號</div>
        <div class="info-value"><%= photo.registration %></div>
      </div>
      <% } %>
      <% if (photo.aircraft_type) { %>
      <div class="info-item">
        <div class="info-label">飛機型號</div>
        <div class="info-value"><%= photo.aircraft_type %></div>
      </div>
      <% } %>
      <% if (photo.engine_type) { %>
      <div class="info-item">
        <div class="info-label">引擎型號</div>
        <div class="info-value"><%= photo.engine_type %></div>
      </div>
      <% } %>
      <% if (photo.origin) { %>
      <div class="info-item">
        <div class="info-label">起點</div>
        <div class="info-value"><%= photo.origin %> <%= photo.origin_iata ? '(' + photo.origin_iata + ')' : '' %></div>
      </div>
      <% } %>
      <% if (photo.destination) { %>
      <div class="info-item">
        <div class="info-label">目的地</div>
        <div class="info-value"><%= photo.destination %> <%= photo.destination_iata ? '(' + photo.destination_iata + ')' : '' %></div>
      </div>
      <% } %>
      <% if (photo.flight_number) { %>
      <div class="info-item">
        <div class="info-label">航班號</div>
        <div class="info-value"><%= photo.flight_number %></div>
      </div>
      <% } %>
      <% if (photo.location) { %>
      <div class="info-item">
        <div class="info-label">拍攝位置</div>
        <div class="info-value"><%= photo.location %></div>
      </div>
      <% } %>
    </div>

    <div class="photographer-bar">
      <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(photo.photographer || 'User') %>&background=3b82f6&color=fff" class="photographer-avatar" alt="avatar">
      <div class="photographer-info">
        <div class="photographer-name"><%= photo.photographer || '未知攝影師' %></div>
        <div class="photographer-date">上傳於 <%= new Date(photo.created_at).toLocaleDateString('zh-HK') %></div>
      </div>
    </div>

    <% if (photo.status !== 'pending' && photo.reviewed_by) { %>
    <div class="reviewer-box">
      <strong>審核員：</strong><%= photo.reviewed_by %>　
      <strong>時間：</strong><%= new Date(photo.reviewed_at).toLocaleString('zh-HK') %>
    </div>
    <% } %>

    <% if (photo.status === 'rejected' && photo.rejection_reason) { %>
    <div class="rejection-box">
      <strong>拒絕原因：</strong><%= photo.rejection_reason %>
    </div>
    <% } %>

    <!-- 管理員審核按鈕 -->
    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
    <div class="admin-actions">
      <button class="admin-btn btn-approve-big" onclick="approvePhoto(<%= photo.id %>)">✅ 批准此作品</button>
      <button class="admin-btn btn-reject-big" onclick="showRejectPanel()">❌ 拒絕此作品</button>
      
      <div class="reject-panel" id="rejectPanel">
        <div class="reject-title">請填寫拒絕原因</div>
        <textarea class="reject-textarea" id="rejectReason" placeholder="例如：相片質素不足、資料有誤..."></textarea>
        <button class="reject-confirm-btn" onclick="rejectPhoto(<%= photo.id %>)">確認拒絕</button>
      </div>
    </div>
    <% } %>
  </div>

  <a href="<%= (typeof user !== 'undefined' && user && user.role === 'admin') ? '/admin' : '/' %>" class="back-link">← 返回</a>
</div>

<script>
  function showRejectPanel() {
    document.getElementById('rejectPanel').classList.add('show');
  }

  async function approvePhoto(id) {
    if (!confirm('確定批准此作品？')) return;
    try {
      const res = await fetch(`/api/admin/photos/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'approved' })
      });
      if (res.ok) {
        alert('✅ 已批准');
        location.reload();
      }
    } catch (err) {
      alert('操作失敗');
    }
  }

  async function rejectPhoto(id) {
    const reason = document.getElementById('rejectReason').value.trim();
    if (!reason) {
      alert('請填寫拒絕原因');
      return;
    }
    if (!confirm('確定拒絕此作品？')) return;
    
    try {
      const res = await fetch(`/api/admin/photos/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'rejected', reason })
      });
      if (res.ok) {
        alert('❌ 已拒絕');
        location.reload();
      }
    } catch (err) {
      alert('操作失敗');
    }
  }
</script>

<%- include('partials/footer') %>