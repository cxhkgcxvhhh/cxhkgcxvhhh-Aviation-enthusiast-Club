<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= photo.title %> — cxhkgcxvhhh Aviation enthusiast Club</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Microsoft JhengHei', 'PingFang HK', Arial, sans-serif; background: #f4f8fc; color: #1a2b3c; }
    .wrap { max-width: 1000px; margin: 40px auto; padding: 0 20px; }
    .photo-box { background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(25,60,100,0.10); margin-bottom: 28px; }
    .photo-box img { width: 100%; display: block; cursor: zoom-in; }
    .card { background: #fff; border-radius: 20px; padding: 28px; box-shadow: 0 8px 30px rgba(25,60,100,0.10); margin-bottom: 24px; }
    h1.title { font-size: 26px; margin-bottom: 18px; color: #0d2137; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .info-item { background: #f4f8fc; border-radius: 12px; padding: 12px 16px; }
    .info-item .label { font-size: 12px; color: #5f7285; margin-bottom: 4px; }
    .info-item .value { font-size: 15px; font-weight: 600; color: #0d2137; word-break: break-word; }
    .extra-box { background: #f4f8fc; border-radius: 12px; padding: 14px 18px; margin-top: 14px; }
    .extra-box .label { font-size: 12px; color: #5f7285; margin-bottom: 6px; }
    .extra-box .value { font-size: 14px; color: #0d2137; white-space: pre-wrap; line-height: 1.8; }
    .people { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .person-card { background: #f4f8fc; border-radius: 14px; padding: 18px; }
    .person-card .role-tag { display: inline-block; font-size: 11px; padding: 3px 10px; border-radius: 999px; margin-bottom: 10px; font-weight: 700; }
    .tag-uploader { background: #e3f2fd; color: #1565c0; }
    .tag-reviewer { background: #fff8e1; color: #b8860b; }
    .person-row { display: flex; align-items: center; gap: 12px; }
    .person-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.12); flex-shrink: 0; }
    .person-initial { width: 44px; height: 44px; border-radius: 50%; background: #1976d2; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 700; flex-shrink: 0; }
    .person-name { font-size: 16px; font-weight: 700; color: #0d2137; display: inline-flex; align-items: center; gap: 5px; text-decoration: none; overflow: visible; }
    .person-name:hover { color: #1976d2; }
    .person-name svg { flex-shrink: 0; overflow: visible; }
    .person-time { font-size: 12px; color: #5f7285; margin-top: 3px; }
    .copyright-line { text-align: center; font-size: 13px; color: #5f7285; margin: 4px 0 24px; font-weight: 600; }
    .back-link { display: inline-block; margin-top: 8px; color: #1976d2; text-decoration: none; font-size: 14px; }
    .back-link:hover { text-decoration: underline; }
    .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 9999; cursor: zoom-out; align-items: center; justify-content: center; }
    .lightbox.show { display: flex; }
    .lightbox img { max-width: 95vw; max-height: 95vh; border-radius: 8px; }
    /* 自動識別卡 */
    .ai-card { background: rgba(255,255,255,0.25); border: 1px solid rgba(255,255,255,0.5); border-radius: 20px; padding: 22px 26px; margin-bottom: 24px; backdrop-filter: blur(16px); }
    .ai-head { font-size: 16px; font-weight: 800; color: #0d2137; margin-bottom: 14px; }
    .ai-main { display: flex; gap: 22px; align-items: flex-start; }
    .ai-left { flex: 1; min-width: 0; }
    .ai-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .ai-item { background: rgba(255,255,255,0.35); border-radius: 12px; padding: 10px 14px; }
    .ai-item .label { font-size: 11px; color: #5f7285; margin-bottom: 3px; }
    .ai-item .value { font-size: 14px; font-weight: 700; color: #0d2137; word-break: break-word; }
    .ai-none { font-size: 13px; color: #5f7285; padding: 10px 4px; }
    .color-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .swatches { display: flex; gap: 6px; }
    .swatch { width: 40px; height: 40px; border-radius: 12px; border: 2px solid rgba(255,255,255,0.7); box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
    .dom-swatch { width: 52px; height: 52px; border-radius: 14px; border: 3px solid rgba(255,255,255,0.8); box-shadow: 0 3px 12px rgba(0,0,0,0.2); }
    .color-info { font-size: 13px; color: #0d2137; line-height: 1.8; }
    .color-info b { font-weight: 800; }
    .gamut-box { flex-shrink: 0; text-align: center; }
    .gamut-box .g-label { font-size: 11px; color: #5f7285; margin-bottom: 6px; }
    .gamut-box canvas { border-radius: 50%; background: rgba(255,255,255,0.35); box-shadow: 0 3px 12px rgba(0,0,0,0.12); }
    @media (max-width: 700px) { .ai-main { flex-direction: column; } .gamut-box { margin: 0 auto; } }
    /* ❤️ 讚好＋收藏＋刪除 */
    .action-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; align-items: center; }
    .act-btn { padding: 10px 24px; border-radius: 999px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; transition: all .18s ease; backdrop-filter: blur(8px); }
    .act-like { background: rgba(255,255,255,0.25); border: 2px solid rgba(224,36,94,0.65); color: #c21a50; }
    .act-like.on { background: #e0245e; color: #fff; border-color: #e0245e; }
    .act-fav { background: rgba(255,255,255,0.25); border: 2px solid rgba(249,168,37,0.7); color: #b8860b; }
    .act-fav.on { background: #f9a825; color: #fff; border-color: #f9a825; }
    .act-del { background: rgba(255,255,255,0.25); border: 2px solid rgba(198,40,40,0.75); color: #c62828; margin-left: auto; }
    .act-del:hover { background: #c62828; color: #fff; }
    /* 💬 留言區 */
    .cm-row { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid #eef3f8; }
    .cm-row:last-of-type { border-bottom: none; }
    .cm-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
    .cm-initial { width: 38px; height: 38px; border-radius: 50%; background: #1976d2; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; flex-shrink: 0; }
    .cm-name { font-size: 13px; font-weight: 700; color: #0d2137; text-decoration: none; }
    .cm-name:hover { color: #1976d2; }
    .cm-time { font-size: 11px; color: #8ba0b3; margin-left: 8px; font-weight: 400; }
    .cm-text { font-size: 14px; color: #34495e; line-height: 1.7; margin-top: 3px; white-space: pre-wrap; }
    .cm-del { font-size: 11px; color: #c62828; background: none; border: none; cursor: pointer; padding: 0; margin-left: 8px; }
    .cm-form { display: flex; gap: 10px; margin-top: 16px; }
    .cm-form input { flex: 1; padding: 10px 14px; border: 1.5px solid #d8e3ee; border-radius: 999px; font-size: 14px; font-family: inherit; }
    .cm-form input:focus { outline: none; border-color: #1976d2; }
    .cm-send { padding: 10px 22px; border-radius: 999px; border: 2px solid #1976d2; background: transparent; color: #1976d2; font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .cm-send:hover { background: #1976d2; color: #fff; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <% function vBadge(u) {
    var star = 'M12 0l2.5 2.4 3.4-.5 1.1 3.1 3.1 1.1-.5 3.4L24 12l-2.4 2.5.5 3.4-3.1 1.1-1.1 3.1-3.4-.5L12 24l-2.5-2.4-3.4.5-1.1-3.1-3.1-1.1.5-3.4L0 12l2.4-2.5-.5-3.4 3.1-1.1 1.1-3.1 3.4.5z';
    var check = '<path fill="#ffffff" d="M10.7 15.9l-3.2-3.2 1.4-1.4 1.8 1.8 4.6-4.6 1.4 1.4z"/>';
    if (u && u.isSuper) return '<svg width="18" height="18" viewBox="0 0 24 24"><path fill="#f5b800" d="' + star + '"/>' + check + '</svg>';
    if (u && u.role === 'admin') return '<svg width="18" height="18" viewBox="0 0 24 24"><path fill="#1d9bf0" d="' + star + '"/>' + check + '</svg>';
    return '';
  } %>

  <div class="wrap">
    <div class="photo-box">
      <img src="<%= photo.image_url %>" alt="<%= photo.title %>" id="mainPhoto" referrerpolicy="no-referrer">
    </div>

    <div class="card">
      <h1 class="title"><%= photo.title %></h1>
      <% var isPlace = ['airport','terminal','ground'].indexOf(photo.category) !== -1; %>
      <div class="info-grid">
        <% if (isPlace) { %>
          <div class="info-item"><div class="label">🛫 機場</div><div class="value"><%= photo.airport_code || '—' %></div></div>
          <% if (photo.category === 'terminal') { %>
            <div class="info-item"><div class="label">🏢 客運大樓</div><div class="value"><%= photo.terminal_name || '—' %></div></div>
          <% } %>
          <% if (photo.category === 'ground') { %>
            <div class="info-item"><div class="label">🧑‍🔧 地勤類型</div><div class="value"><%= photo.ground_type || '—' %></div></div>
          <% } %>
          <div class="info-item"><div class="label">📅 拍攝日期</div><div class="value"><%= photo.photo_date || '—' %></div></div>
          <div class="info-item"><div class="label">📍 拍攝地點</div><div class="value"><%= photo.location || '—' %></div></div>
        <% } else { %>
          <div class="info-item"><div class="label">✈️ 註冊號</div><div class="value"><%= photo.registration || '—' %></div></div>
          <div class="info-item"><div class="label">🏢 航空公司</div><div class="value"><%= photo.airline || '—' %></div></div>
          <div class="info-item"><div class="label">🔢 航班編號</div><div class="value"><%= photo.flight_number || '—' %></div></div>
          <div class="info-item"><div class="label">🛩️ 機型</div><div class="value"><%= photo.aircraft_type || '—' %></div></div>
          <div class="info-item"><div class="label">🎨 塗裝</div><div class="value"><%= photo.livery || '—' %></div></div>
          <div class="info-item"><div class="label">🗺️ 航線</div><div class="value"><%= (photo.origin || '?') + ' → ' + (photo.destination || '?') %></div></div>
          <div class="info-item"><div class="label">📅 拍攝日期</div><div class="value"><%= photo.photo_date || '—' %></div></div>
          <div class="info-item"><div class="label">📍 拍攝地點</div><div class="value"><%= photo.location || '—' %></div></div>
        <% } %>
      </div>

      <% if (photo.camera_settings) { %>
        <div class="extra-box">
          <div class="label">📷 相機設定</div>
          <div class="value"><%= photo.camera_settings %></div>
        </div>
      <% } %>

      <% if (photo.extra_info) { %>
        <div class="extra-box">
          <div class="label">📝 額外資料</div>
          <div class="value"><%= photo.extra_info %></div>
        </div>
      <% } %>
    </div>

    <!-- 圖片資料自動識別 -->
    <div class="ai-card">
      <div class="ai-head">圖片資料自動識別</div>

      <div class="ai-main">
        <div class="ai-left">
          <% if (photo.exif) { %>
            <div class="ai-grid">
              <% if (photo.exif.camera) { %><div class="ai-item"><div class="label">📷 相機</div><div class="value"><%= photo.exif.camera %></div></div><% } %>
              <% if (photo.exif.lens) { %><div class="ai-item"><div class="label">🔭 鏡頭</div><div class="value"><%= photo.exif.lens %></div></div><% } %>
              <% if (photo.exif.focal) { %><div class="ai-item"><div class="label">📏 焦距</div><div class="value"><%= photo.exif.focal %></div></div><% } %>
              <% if (photo.exif.aperture) { %><div class="ai-item"><div class="label">🔆 光圈</div><div class="value"><%= photo.exif.aperture %></div></div><% } %>
              <% if (photo.exif.shutter) { %><div class="ai-item"><div class="label">⏱️ 快門速度</div><div class="value"><%= photo.exif.shutter %></div></div><% } %>
              <% if (photo.exif.iso) { %><div class="ai-item"><div class="label">🎞️ 感光度</div><div class="value"><%= photo.exif.iso %></div></div><% } %>
            </div>
          <% } else { %>
            <div class="ai-none">📷 呢張相冇 EXIF 拍攝資料（可能經過社交 app 或截圖，資料已被移除）</div>
          <% } %>

          <% if (photo.colors) { %>
            <div class="color-row">
              <div>
                <div style="font-size:11px;color:#5f7285;margin-bottom:4px;">🎨 主色</div>
                <div class="dom-swatch" style="background:<%= photo.colors.dominant %>;" title="<%= photo.colors.dominant %>"></div>
              </div>
              <div>
                <div style="font-size:11px;color:#5f7285;margin-bottom:4px;">🌈 色彩分佈</div>
                <div class="swatches">
                  <% photo.colors.palette.forEach(function(c) { %>
                    <div class="swatch" style="background:<%= c %>;" title="<%= c %>"></div>
                  <% }) %>
                </div>
              </div>
              <div class="color-info">
                <b><%= photo.colors.brightnessDesc %></b>（亮度 <%= photo.colors.brightness %>/255）<br>
                <b><%= photo.colors.toneDesc %></b>
              </div>
            </div>
          <% } %>
        </div>

        <% if (photo.colors && photo.colors.gamut && photo.colors.gamut.length > 0) { %>
          <div class="gamut-box">
            <div class="g-label">🌈 色域圖</div>
            <canvas id="gamutCanvas" width="190" height="190"></canvas>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="people">
        <div class="person-card">
          <span class="role-tag tag-uploader">📤 上載者</span>
          <div class="person-row">
            <% if (uploader.avatar) { %>
              <a href="/user/<%= uploader.id %>"><img class="person-avatar" src="<%= uploader.avatar %>" referrerpolicy="no-referrer" alt=""></a>
            <% } else { %>
              <a href="/user/<%= uploader.id %>" style="text-decoration:none;"><span class="person-initial"><%= (uploader.name || '?').charAt(0).toUpperCase() %></span></a>
            <% } %>
            <div>
              <a class="person-name" href="/user/<%= uploader.id %>"><%= uploader.name %> <%- vBadge(uploader) %></a>
              <div class="person-time">🕐 上載時間：<%= new Date(photo.created_at).toLocaleString('zh-HK') %></div>
            </div>
          </div>
        </div>

        <div class="person-card">
          <span class="role-tag tag-reviewer">👑 審核員</span>
          <% if (reviewer) { %>
            <div class="person-row">
              <% if (reviewer.avatar) { %>
                <% if (reviewer.id) { %>
                  <a href="/user/<%= reviewer.id %>"><img class="person-avatar" src="<%= reviewer.avatar %>" referrerpolicy="no-referrer" alt=""></a>
                <% } else { %>
                  <img class="person-avatar" src="<%= reviewer.avatar %>" referrerpolicy="no-referrer" alt="">
                <% } %>
              <% } else if (reviewer.id) { %>
                <a href="/user/<%= reviewer.id %>" style="text-decoration:none;"><span class="person-initial"><%= (reviewer.name || '?').charAt(0).toUpperCase() %></span></a>
              <% } else { %>
                <span class="person-initial"><%= (reviewer.name || '?').charAt(0).toUpperCase() %></span>
              <% } %>
              <div>
                <% if (reviewer.id) { %>
                  <a class="person-name" href="/user/<%= reviewer.id %>"><%= reviewer.name %> <%- vBadge(reviewer) %></a>
                <% } else { %>
                  <span class="person-name"><%= reviewer.name %> <%- vBadge(reviewer) %></span>
                <% } %>
                <div class="person-time">🕐 審核時間：<%= photo.reviewed_at ? new Date(photo.reviewed_at).toLocaleString('zh-HK') : '—' %></div>
              </div>
            </div>
          <% } else { %>
            <div class="person-row">
              <span class="person-initial">?</span>
              <div>
                <span class="person-name">未審核</span>
                <div class="person-time">呢張相仲未有人審核</div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ❤️ 讚好＋⭐ 收藏＋🗑️ 永久刪除（總管理員） -->
    <div class="action-row">
      <button class="act-btn act-like <%= liked ? 'on' : '' %>" id="likeBtn" onclick="toggleLike()">❤️ <span id="likeCount"><%= likeCount %></span> 個讚</button>
      <button class="act-btn act-fav <%= favorited ? 'on' : '' %>" id="favBtn" onclick="toggleFav()"><%= favorited ? '⭐ 已收藏' : '⭐ 收藏' %></button>
      <% if (user && user.isSuper) { %>
        <button class="act-btn act-del" onclick="deletePhoto()">🗑️ 永久刪除（總管理員）</button>
      <% } %>
    </div>

    <!-- 💬 留言區 -->
    <div class="card">
      <h1 class="title" style="font-size:20px;">💬 留言（<%= photoComments.length %>）</h1>
      <% if (photoComments.length === 0) { %>
        <div style="color:#8ba0b3;font-size:13px;padding:8px 0;">仲未有留言，做第一個留言嘅人啦！</div>
      <% } %>
      <% photoComments.forEach(function(c) { %>
        <div class="cm-row">
          <% if (c.avatar) { %>
            <a href="/user/<%= c.user_id %>"><img class="cm-avatar" src="<%= c.avatar %>" referrerpolicy="no-referrer" alt=""></a>
          <% } else { %>
            <a href="/user/<%= c.user_id %>" style="text-decoration:none;"><span class="cm-initial"><%= (c.user_name || '?').charAt(0).toUpperCase() %></span></a>
          <% } %>
          <div style="flex:1;">
            <a class="cm-name" href="/user/<%= c.user_id %>"><%= c.user_name %></a><span class="cm-time"><%= new Date(c.created_at).toLocaleString('zh-HK') %></span><% if (user && (user.id === c.user_id || user.role === 'admin')) { %><button class="cm-del" onclick="delComment(<%= c.id %>)">刪除</button><% } %>
            <div class="cm-text"><%= c.text %></div>
          </div>
        </div>
      <% }) %>
      <% if (user) { %>
        <div class="cm-form">
          <input type="text" id="cmInput" maxlength="500" placeholder="寫低你嘅留言…（最多 500 字）">
          <button class="cm-send" onclick="sendComment()">送出</button>
        </div>
      <% } else { %>
        <div style="font-size:13px;color:#5f7285;margin-top:14px;"><a href="/login" style="color:#1976d2;">登入</a> 之後就可以留言啦！</div>
      <% } %>
    </div>

    <div class="copyright-line">© <%= uploader.name %>-cxcvaec</div>

    <a class="back-link" href="javascript:history.back()">← 返回上一頁</a>
  </div>

  <div class="lightbox" id="lightbox">
    <img src="<%= photo.image_url %>" alt="<%= photo.title %>">
  </div>

  <script>
    var mainPhoto = document.getElementById('mainPhoto');
    var lightbox = document.getElementById('lightbox');
    mainPhoto.addEventListener('click', function () { lightbox.classList.add('show'); });
    lightbox.addEventListener('click', function () { lightbox.classList.remove('show'); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') lightbox.classList.remove('show');
    });

    // ❤️ 讚好
    function toggleLike() {
      <% if (!user) { %> window.location.href = '/login'; return; <% } %>
      fetch('/api/photos/<%= photo.id %>/like', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) { alert('❌ ' + (d.error || '失敗')); return; }
          document.getElementById('likeCount').textContent = d.likeCount;
          document.getElementById('likeBtn').classList.toggle('on', d.liked);
        });
    }

    // ⭐ 收藏
    function toggleFav() {
      <% if (!user) { %> window.location.href = '/login'; return; <% } %>
      fetch('/api/photos/<%= photo.id %>/favorite', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (!d.ok) { alert('❌ ' + (d.error || '失敗')); return; }
          var b = document.getElementById('favBtn');
          b.classList.toggle('on', d.favorited);
          b.textContent = d.favorited ? '⭐ 已收藏' : '⭐ 收藏';
        });
    }

    // 🗑️ 永久刪除（總管理員）
    function deletePhoto() {
      if (!confirm('⚠️ 確定要永久刪除呢張相？\n\n相片會連同所有留言一齊喺資料庫同硬碟永久刪除，冇得還原！')) return;
      if (!confirm('最後確認：真係要刪除「<%= photo.title.replace(/'/g, '') %>」？')) return;
      fetch('/api/superadmin/photos/<%= photo.id %>/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.ok) { alert('✅ 已永久刪除'); window.location.href = '/gallery'; }
          else alert('❌ ' + (d.error || '失敗'));
        });
    }

    // 💬 留言
    function sendComment() {
      var text = document.getElementById('cmInput').value.trim();
      if (!text) { alert('❌ 留言唔可以空白'); return; }
      fetch('/api/photos/<%= photo.id %>/comment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: text })
      }).then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.ok) location.reload();
          else alert('❌ ' + (d.error || '失敗'));
        });
    }
    document.getElementById('cmInput') && document.getElementById('cmInput').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') sendComment();
    });

    function delComment(id) {
      if (!confirm('刪除呢個留言？')) return;
      fetch('/api/comments/' + id + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.ok) location.reload();
          else alert('❌ ' + (d.error || '失敗'));
        });
    }

    // 🎨 色域圖：圓形色輪底 + 每點係張相入面嘅一隻色
    (function () {
      var canvas = document.getElementById('gamutCanvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = canvas.width, H = canvas.height;
      var cx = W / 2, cy = H / 2, R = W / 2 - 8;

      // 畫色輪底（淡色）
      for (var ang = 0; ang < 360; ang += 2) {
        var grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, R);
        grad.addColorStop(0, 'rgba(255,255,255,0.9)');
        grad.addColorStop(1, 'hsla(' + ang + ', 80%, 65%, 0.35)');
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, R, (ang - 1.5) * Math.PI / 180, (ang + 1.5) * Math.PI / 180);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();
      }

      // 中間白心
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.22, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.fill();

      // 畫數據點
      var gamut = <%- JSON.stringify((photo.colors && photo.colors.gamut) ? photo.colors.gamut : []) %>;
      gamut.forEach(function (pt) {
        var h = pt[0], s = pt[1], l = pt[2];
        var rad = (h - 90) * Math.PI / 180;
        var dist = (s / 100) * (R - 6);
        var x = cx + Math.cos(rad) * dist;
        var y = cy + Math.sin(rad) * dist;
        ctx.beginPath();
        ctx.arc(x, y, 3.2, 0, Math.PI * 2);
        ctx.fillStyle = 'hsl(' + h + ', ' + s + '%, ' + l + '%)';
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.strokeStyle = 'rgba(255,255,255,0.7)';
        ctx.stroke();
      });
    })();
  </script>
</body>