<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>cxhkgcxvhhh Aviation enthusiast Club</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Microsoft JhengHei', 'PingFang HK', Arial, sans-serif; background: #f4f8fc; color: #1a2b3c; }
    .wrap { max-width: 1200px; margin: 36px auto; padding: 0 20px; }
    .hero { text-align: center; margin-bottom: 30px; }
    .hero h1 { font-size: 32px; color: #0d2137; }
    .hero p { color: #41576b; margin-top: 8px; font-size: 15px; }

    /* 六個統計框 — 超透明 */
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin-bottom: 30px; }
    .stat-card {
      background: rgba(255,255,255,0.10);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.35);
      border-radius: 20px;
      padding: 18px 12px;
      text-align: center;
    }
    .stat-card .num { font-size: 26px; font-weight: 900; color: #0d2137; }
    .stat-card .lbl { font-size: 12px; color: #41576b; margin-top: 4px; }

    .layout { display: grid; grid-template-columns: 1fr 300px; gap: 24px; align-items: start; }
    @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }

    .section-title { font-size: 20px; font-weight: 800; color: #0d2137; margin: 26px 0 14px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
    .p-card { display: block; background: rgba(255,255,255,0.2); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.4); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s; }
    .p-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(25,60,100,0.18); }
    .p-card img { width: 100%; height: 130px; object-fit: cover; display: block; }
    .p-info { padding: 12px 14px; }
    .p-title { font-size: 14px; font-weight: 700; color: #0d2137; }
    .p-sub { font-size: 11.5px; color: #5f7285; margin-top: 3px; }
    .empty { color: #8ba0b3; font-size: 14px; padding: 20px 0; }

    /* 排行榜／新聞 — 超透明框 */
    .lb-card {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 22px;
      padding: 18px;
      margin-bottom: 18px;
    }
    .lb-card h3 { font-size: 15px; color: #0d2137; margin-bottom: 12px; }
    .lb-row { display: flex; align-items: center; gap: 10px; padding: 8px 6px; border-radius: 12px; font-size: 13px; }
    .lb-row:hover { background: rgba(255,255,255,0.15); }
    .lb-rank { width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex-shrink: 0; background: rgba(255,255,255,0.35); color: #41576b; }
    .lb-rank.r1 { background: #ffd54f; color: #6d4c00; }
    .lb-rank.r2 { background: #e0e0e0; color: #455a64; }
    .lb-rank.r3 { background: #ffab91; color: #6d3200; }
    .lb-name { flex: 1; font-weight: 700; color: #0d2137; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .lb-count { font-size: 12px; color: #41576b; font-weight: 700; }
    .lb-empty { font-size: 12px; color: #8ba0b3; padding: 6px; }

    /* 新聞（連縮圖） */
    .news-item { display: flex; gap: 10px; padding: 10px 6px; border-bottom: 1px solid rgba(255,255,255,0.25); }
    .news-item:last-of-type { border-bottom: none; }
    .news-item img { width: 64px; height: 48px; object-fit: cover; border-radius: 10px; flex-shrink: 0; }
    .news-item .nt { font-weight: 700; color: #0d2137; font-size: 13px; line-height: 1.4; }
    .news-item .nc { font-size: 11.5px; color: #41576b; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .news-item .ns { font-size: 11px; color: #5f7285; margin-top: 3px; }
    .more-news { display: block; text-align: center; margin-top: 12px; padding: 9px; border-radius: 999px; border: 1.5px solid rgba(25,118,210,0.45); color: #1565c0; font-size: 13px; font-weight: 700; text-decoration: none; background: rgba(255,255,255,0.15); }
    .more-news:hover { background: rgba(25,118,210,0.15); }

    /* 🖼️ 精選輪播 */
    .carousel { position: relative; border-radius: 22px; overflow: hidden; margin-bottom: 30px; box-shadow: 0 12px 36px rgba(25,60,100,0.18); }
    .carousel .slide { display: none; position: relative; text-decoration: none; color: inherit; }
    .carousel .slide.on { display: block; }
    .carousel .slide img { width: 100%; height: 380px; object-fit: cover; display: block; }
    @media (max-width: 700px) { .carousel .slide img { height: 220px; } }
    .carousel .cap {
      position: absolute; left: 0; right: 0; bottom: 0;
      padding: 18px 22px; color: #fff;
      background: linear-gradient(transparent, rgba(10,25,40,0.75));
    }
    .carousel .cap .ct { font-size: 17px; font-weight: 800; }
    .carousel .cap .cs { font-size: 12px; opacity: 0.85; margin-top: 3px; }
    .carousel .car-btn {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 42px; height: 42px; border-radius: 50%; border: none; cursor: pointer;
      background: rgba(255,255,255,0.3); color: #fff; font-size: 20px; font-weight: 800;
      backdrop-filter: blur(6px); transition: background .2s;
    }
    .carousel .car-btn:hover { background: rgba(255,255,255,0.55); }
    .carousel .car-prev { left: 14px; }
    .carousel .car-next { right: 14px; }
    .carousel .car-dots { position: absolute; bottom: 12px; right: 18px; display: flex; gap: 6px; }
    .carousel .car-dot { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,0.45); cursor: pointer; }
    .carousel .car-dot.on { background: #fff; }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="wrap">
    <div class="hero">
      <h1>✈️ cxhkgcxvhhh Aviation enthusiast Club</h1>
      <p>分享你嘅航空攝影作品，同其他飛機迷一齊交流！</p>
    </div>

    <div class="stats" id="statsRow">
      <div class="stat-card"><div class="num" id="stTotal">—</div><div class="lbl">今日總上傳</div></div>
      <div class="stat-card"><div class="num" id="stApproved">—</div><div class="lbl">今日已通過</div></div>
      <div class="stat-card"><div class="num" id="stRejected">—</div><div class="lbl">今日被拒絕</div></div>
      <div class="stat-card"><div class="num" id="stGallery">—</div><div class="lbl">圖庫總數</div></div>
      <div class="stat-card"><div class="num" id="stTodayRate">—</div><div class="lbl">今日通過率</div></div>
      <div class="stat-card"><div class="num" id="stOverallRate">—</div><div class="lbl">整體通過率</div></div>
    </div>

    <div class="layout">
      <div>
        <% if (featured.length > 0) { %>
        <div class="carousel" id="carousel">
          <% featured.forEach(function(p, i) { %>
            <a class="slide <%= i === 0 ? 'on' : '' %>" href="/photo/<%= p.id %>">
              <img src="<%= p.image_url %>" alt="<%= p.title %>">
              <div class="cap">
                <div class="ct">⭐ <%= p.title %></div>
                <div class="cs">📸 <%= p.user_name %><% if (p.registration) { %> · <%= p.registration %><% } %><% if (p.airline) { %> · <%= p.airline %><% } %></div>
              </div>
            </a>
          <% }) %>
          <% if (featured.length > 1) { %>
            <button class="car-btn car-prev" onclick="carMove(-1)">‹</button>
            <button class="car-btn car-next" onclick="carMove(1)">›</button>
            <div class="car-dots">
              <% featured.forEach(function(p, i) { %>
                <span class="car-dot <%= i === 0 ? 'on' : '' %>" onclick="carGo(<%= i %>)"></span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <% } %>

        <div class="section-title">⭐ 精選作品</div>
        <% if (featured.length === 0) { %>
          <div class="empty">暫時未有精選作品 — 管理員可以喺後台將靚相設為精選！</div>
        <% } %>
        <div class="grid">
          <% featured.forEach(function(p) { %>
            <a class="p-card" href="/photo/<%= p.id %>">
              <img src="<%= p.image_url %>" alt="<%= p.title %>" loading="lazy">
              <div class="p-info">
                <div class="p-title"><%= p.title %></div>
                <div class="p-sub"><%= p.registration %> · <%= p.airline %></div>
                <div class="p-sub">📸 <%= p.user_name %></div>
              </div>
            </a>
          <% }) %>
        </div>

        <div class="section-title">🆕 最新作品</div>
        <% if (latest.length === 0) { %>
          <div class="empty">暫時未有作品，快啲上載第一張啦！</div>
        <% } %>
        <div class="grid">
          <% latest.forEach(function(p) { %>
            <a class="p-card" href="/photo/<%= p.id %>">
              <img src="<%= p.image_url %>" alt="<%= p.title %>" loading="lazy">
              <div class="p-info">
                <div class="p-title"><%= p.title %></div>
                <div class="p-sub"><%= p.registration %> · <%= p.airline %></div>
                <div class="p-sub">📸 <%= p.user_name %></div>
              </div>
            </a>
          <% }) %>
        </div>
      </div>

      <div>
        <div class="lb-card">
          <h3>🏆 圖片貢獻者排行榜</h3>
          <% if (topContributors.length === 0) { %>
            <div class="lb-empty">暫時未有數據</div>
          <% } %>
          <% topContributors.forEach(function(u, i) { %>
            <div class="lb-row">
              <span class="lb-rank <%= i === 0 ? 'r1' : (i === 1 ? 'r2' : (i === 2 ? 'r3' : '')) %>"><%= i + 1 %></span>
              <span class="lb-name"><%= u.name %></span>
              <span class="lb-count"><%= u.count %> 📷</span>
            </div>
          <% }) %>
        </div>

        <div class="lb-card">
          <h3>📈 今日通過王</h3>
          <% if (topToday.length === 0) { %>
            <div class="lb-empty">今日暫時未有通過嘅相片</div>
          <% } %>
          <% topToday.forEach(function(u, i) { %>
            <div class="lb-row">
              <span class="lb-rank <%= i === 0 ? 'r1' : (i === 1 ? 'r2' : (i === 2 ? 'r3' : '')) %>"><%= i + 1 %></span>
              <span class="lb-name"><%= u.name %></span>
              <span class="lb-count"><%= u.count %> ✅</span>
            </div>
          <% }) %>
        </div>

        <div class="lb-card">
          <h3>📰 最新航空新聞</h3>
          <% if (newsList.length === 0) { %>
            <div class="lb-empty">暫時未有新聞</div>
          <% } %>
          <% newsList.forEach(function(n) { %>
            <div class="news-item">
              <% if (n.image_url) { %>
                <img src="<%= n.image_url %>" alt="" loading="lazy">
              <% } %>
              <div>
                <div class="nt"><%= n.title %></div>
                <div class="nc"><%= n.content %></div>
                <div class="ns">來源：<%= n.source %> · <%= new Date(n.created_at).toLocaleDateString('zh-HK') %></div>
              </div>
            </div>
          <% }) %>
          <a class="more-news" href="/news">查看更多新聞 →</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 🖼️ 精選輪播（每 5 秒自動轉）
    var carIdx = 0;
    var carSlides = document.querySelectorAll('#carousel .slide');
    var carDots = document.querySelectorAll('#carousel .car-dot');
    function carGo(i) {
      if (carSlides.length === 0) return;
      carIdx = (i + carSlides.length) % carSlides.length;
      carSlides.forEach(function (sl, j) { sl.classList.toggle('on', j === carIdx); });
      carDots.forEach(function (d, j) { d.classList.toggle('on', j === carIdx); });
    }
    function carMove(step) { carGo(carIdx + step); }
    if (carSlides.length > 1) setInterval(function () { carMove(1); }, 5000);

    fetch('/api/stats/today')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        document.getElementById('stTotal').textContent = d.total;
        document.getElementById('stApproved').textContent = d.approved;
        document.getElementById('stRejected').textContent = d.rejected;
        document.getElementById('stGallery').textContent = d.galleryTotal;
        document.getElementById('stTodayRate').textContent = d.todayRate + '%';
        document.getElementById('stOverallRate').textContent = d.overallRate + '%';
      })
      .catch(function () {});
  </script>
</body>
</html>